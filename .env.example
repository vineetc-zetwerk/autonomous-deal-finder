# Copy this file to .env and fill in your own values. Never commit .env.
HF_TOKEN=

# If you do not use a local Modal profile, uncomment and set both variables.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Credentials from your Modal Shared Endpoint's proxy token.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_SHARED_ENDPOINT_MODEL=Qwen/Qwen3.8-2.4T-A95B
MODAL_SHARED_ENDPOINT_URL=https://YOUR-ENDPOINT.modal.direct/v1/chat/completions

# Defaults shown for clarity. The adapter requires this exact base model.
HF_BASE_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct
HF_PRICE_ADAPTER_ID=chitlangiavineet09/llama-3.2-3b-price-predictor-qlora
PRICER_PREPROCESSOR_MODEL=meta-llama/Llama-3.2-3B-Instruct
